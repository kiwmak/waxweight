# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server Configuration
PORT=3000

# JWT Secret - đặt chuỗi ngẫu nhiên dài, KHÔNG dùng lại giá trị mẫu này
JWT_SECRET=change-me-to-a-long-random-string

# Admin Account (tạo lần đầu, dùng cho create-admin.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@system.com

# Môi trường: development | production
NODE_ENV=development

# Danh sách domain được phép gọi API (phân tách bằng dấu phẩy)
# ALLOWED_ORIGINS=https://waxweight.example.com
ALLOWED_ORIGINS=
